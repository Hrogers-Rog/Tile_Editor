{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrogers.dev/railroader/ctc-system/v1",
  "title": "Hrogers Railroader Signaling and Train Order System",
  "type": "object",
  "required": ["formatVersion", "territories", "controlPoints", "blocks", "trainOrders"],
  "properties": {
    "formatVersion": { "const": 1 },
    "territories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "mode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["train-orders", "abs", "ctc"] },
          "signalFamily": { "enum": ["semaphore", "searchlight", "position-light", "color-light"] },
          "era": { "type": "string" },
          "controlPointIds": { "$ref": "#/$defs/idArray" },
          "blockIds": { "$ref": "#/$defs/idArray" }
        },
        "additionalProperties": true
      }
    },
    "controlPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "switches", "routes"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "board": { "$ref": "#/$defs/point" },
          "switches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["nodeId"],
              "properties": {
                "nodeId": { "$ref": "#/$defs/id" },
                "normalLabel": { "type": "string" },
                "reverseLabel": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "entrySignalId", "blockIds", "switchSettings"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "label": { "type": "string" },
                "entrySignalId": { "$ref": "#/$defs/id" },
                "blockIds": { "$ref": "#/$defs/idArray" },
                "switchSettings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["nodeId", "thrown"],
                    "properties": {
                      "nodeId": { "$ref": "#/$defs/id" },
                      "thrown": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "mode", "segmentIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["abs", "ctc", "manual"] },
          "segmentIds": { "$ref": "#/$defs/idArray" },
          "signals": {
            "type": "object",
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" }
            },
            "additionalProperties": false
          },
          "nextBlocks": {
            "type": "object",
            "properties": {
              "fromA": { "type": "string" },
              "fromB": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "trainOrders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "type", "status", "limits"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "number": { "type": "integer", "minimum": 1 },
          "type": {
            "enum": ["Form 19", "Form 31", "Track Warrant", "Meet Order", "Hold Order", "Run Extra"]
          },
          "trainId": { "type": "string" },
          "crew": { "type": "string" },
          "crewId": { "type": "string" },
          "limits": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            },
            "additionalProperties": false
          },
          "meetAt": { "type": "string" },
          "text": { "type": "string" },
          "status": {
            "enum": ["Draft", "Issued", "Delivered", "Acknowledged", "Fulfilled", "Cancelled"]
          },
          "priority": { "type": "integer", "minimum": 0 },
          "effective": { "type": "string" },
          "expires": { "type": "string" },
          "requiresAcknowledgement": { "type": "boolean" },
          "authority": {
            "type": "object",
            "properties": {
              "blockIds": { "$ref": "#/$defs/idArray" },
              "enforce": { "type": "boolean" },
              "maxSpeedMph": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
